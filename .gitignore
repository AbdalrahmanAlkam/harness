venv/

# Everything under output/ is generated state, not source: the experience
# database (which holds full conversation transcripts, unencrypted), the
# trained model artifact, plots, exported sessions, and the clipboard mirror.
# None of it belongs in version control, and the database in particular can
# hold anything a user has ever typed.
output/

# Clipboard mirror: a deliberate copy of whatever the user last selected or
# copied, so it can hold keys or other secrets. It is a recovery buffer, never
# a source file. (Covered by output/ above; kept explicit so the reason is
# visible to anyone who later re-adds an output/ exception.)
output/clipboard/

# Research run artifacts. These are per-topic trees -- ledgers, papers, PDFs,
# compiled proofs -- regenerated by `adaptive-harness research`.
/research/

.env
.env.*
.harness/
